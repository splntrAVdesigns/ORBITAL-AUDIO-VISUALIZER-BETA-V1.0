  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.4",
  "license": "MIT",
  "author": "SPLNTR",
  "repository": {
    "type": "git",
    "url": "https://github.com/splntrAVdesigns/orbital-audio-visualizer-beta-v1-0.git"
  },
  "homepage": "https://github.com/splntrAVdesigns/orbital-audio-visualizer-beta-v1-0#readme",
