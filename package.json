    "typecheck:runtime": "tsc -p src/app/tsconfig.runtime.json",
    "audit:source": "node scripts/audit-source-graph.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify:fallback-freeze": "node scripts/verify-main-thread-fallback-freeze.mjs",
    "verify:core-particle-fallback": "node scripts/verify-core-particle-fallback-freeze.mjs",
    "smoke:mount": "node scripts/smoke-app-mount.mjs",
    "audit:window-bridges": "node scripts/audit-window-bridges.mjs",
    "baseline:main-thread": "node scripts/report-main-thread-baseline.mjs",
    "verify:dist": "node scripts/verify-dist-output.mjs",
    "baseline:browser": "node scripts/capture-browser-baseline.mjs",
    "field:phase4-5": "node scripts/capture-browser-baseline.mjs --out=artifacts/phase4-5-field.json",
    "verify:phase4-5-field": "node scripts/verify-phase4-5-field-report.mjs",
    "capture:core-particles-parity": "node scripts/capture-core-particles-parity.mjs",
    "test:tap-tempo": "node scripts/test-tap-tempo.mjs",
    "test:bpm-detector": "node scripts/test-bpm-detector.mjs",
    "test:rotation-sparks": "node scripts/test-rotation-sparks.mjs",
    "test:runtime-soak": "node scripts/test-runtime-soak.mjs",
    "test:audio-memory": "node scripts/test-audio-memory-lifecycle.mjs",
    "test:export-memory": "node scripts/test-export-memory-containment.mjs",
    "audit:async-ownership": "node scripts/audit-async-ownership.mjs",
    "test:async-lifecycle": "node scripts/test-async-lifecycle.mjs",
    "test:recording-controls": "node scripts/test-recording-controls.mjs",
    "test:recording-fidelity": "node scripts/test-recording-fidelity.mjs",
    "test:preflight": "node scripts/run-unit-tests.mjs",
    "test:beta-safety": "node scripts/test-beta-safety-contracts.mjs",
    "test:phase4-8a-renderer-kernel": "node scripts/test-phase4-8a-renderer-kernel-extraction.mjs",
    "test:phase4-8b-host-contract": "node scripts/test-phase4-8b-host-contract.mjs",
    "test:phase4-8b-control-parity": "node scripts/test-phase4-8b-control-parity.mjs",
