    "test:phase4-8h1-frame-shell": "node scripts/test-phase4-8h1-production-frame-shell.mjs",
    "test:phase4-8h2-state-runtime": "node scripts/test-phase4-8h2-state-runtime-extraction.mjs",
    "test:phase4-8h3-feature-runtime": "node scripts/test-phase4-8h3-renderer-feature-runtime-extraction.mjs",
    "test:refactor-phase2": "node scripts/test-refactor-phase2-session-services.mjs",
    "test:refactor-phase3": "node scripts/test-refactor-phase3-production-frame-controller.mjs",
    "test:phase4-8h4-side-effects": "node scripts/test-phase4-8h4-side-effect-separation.mjs",
    "test:phase4-8h5-certification": "node scripts/test-phase4-8h5-performance-certification.mjs",
    "test:phase4-8i-cadence": "node scripts/test-phase4-8i-cadence-recovery.mjs",
    "test:phase4-8j": "npm run test:phase4-8j-base && npm run test:phase4-8j1 && npm run test:phase4-8j2 && npm run test:phase4-8j3",
    "test:phase4-8j-base": "node scripts/test-phase4-8j-control-panel-isolation.mjs",
    "test:phase4-8j1": "node scripts/test-phase4-8j1-native-control-preview-isolation.mjs",
    "test:phase4-8j2": "node scripts/test-phase4-8j2-surface-interaction-isolation.mjs",
    "test:phase4-8j3": "node scripts/_test-phase4-8j3-interaction-hard-boundary.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "happy-dom": "^20.10.6",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
